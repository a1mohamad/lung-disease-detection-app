# Docker Compose (canonical app/runtime keys)

# Core ports
APP_PORT=8000
AIRFLOW_PORT=8080
MLFLOW_PORT=5000
KAFKA_UI_PORT=8081

# SQL Server container and app DB
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
DB_HOST=db
DB_PORT=1433
DB_NAME=lung_detection
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
DB_ECHO=false
DB_LOGGING_ENABLED=true

# App runtime and auth
TF_CPP_MIN_LOG_LEVEL=3
TF_ENABLE_ONEDNN_OPTS=0
LOGS_API_KEY=your_long_random_api_key

# Kafka
KAFKA_ENABLED=true
KAFKA_IMAGE_TAG=7.6.1
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ADVERTISED_HOST=localhost
KAFKA_EXTERNAL_PORT=9092
KAFKA_TOPIC_PREDICTIONS=lung.predictions
KAFKA_CLIENT_ID=lung-api-producer
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_GROUP_DB=lung-consumer-db
KAFKA_GROUP_MONITORING=lung-consumer-monitoring
KAFKA_GROUP_ANALYTICS=lung-consumer-analytics
KAFKA_GROUP_DOCTOR=lung-consumer-doctor
KAFKA_GROUP_NOTIFICATIONS=lung-consumer-notifications
KAFKA_UI_IMAGE_TAG=v0.7.2
KAFKA_UI_CLUSTER_NAME=local
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000
KAFKA_BROKER_ID=1

# MLflow and model registry
MLFLOW_ENABLED=true
MLFLOW_STRICT=false
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_MODEL_STAGE=Production
MLFLOW_MODEL_NAME_DENSENET_BINARY=lung-binary-densenet
MLFLOW_MODEL_NAME_EFFICIENTNET_BINARY=lung-binary-efficientnet
MLFLOW_MODEL_NAME_INCEPTION_BINARY=lung-binary-inception
MLFLOW_MODEL_NAME_MOBILENET_BINARY=lung-binary-mobilenet
MLFLOW_MODEL_NAME_DISEASES=lung-diseases-densenet
MLFLOW_MODEL_NAME_SEGMENTATION=lung-segmentation-unet-xception
MLFLOW_BACKEND_DB=mlflow_backend
MLFLOW_DEFAULT_ARTIFACT_ROOT=/mlflow/artifacts
MLFLOW_BACKEND_STORE_URI=mssql+pyodbc://sa:${MSSQL_SA_PASSWORD}@db:${DB_PORT}/${MLFLOW_BACKEND_DB}?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=no&TrustServerCertificate=yes

# Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
