# Used by docker-compose.runtime.yml (container env + optional Compose interpolation).
# Run: docker compose --env-file .env.runtime -f docker-compose.runtime.yml up --build
# (--env-file avoids deployment/.env overriding ${APP_PORT} in the compose file)

APP_PORT=8000

TF_CPP_MIN_LOG_LEVEL=3
TF_ENABLE_ONEDNN_OPTS=0

# Slim deploy: Kafka + MLflow are off; the app runs standalone.
MLFLOW_ENABLED=false
MLFLOW_STRICT=false
KAFKA_ENABLED=false

# --- Model artifacts ---
# Local Docker can keep mounting ./saved_models. Cloud deploys can download models
# from Hugging Face at startup instead.
HF_MODEL_DOWNLOAD_ENABLED=true
HF_MODEL_REPO_ID=a1mohamadd/lung-disease-detection
HF_MODEL_REPO_TYPE=model
HF_MODEL_REVISION=main
# Set only if the repo contains a nested saved_models/ folder instead of model folders at repo root.
HF_MODEL_REPO_SUBDIR=
# Secret. Set this in Render/Railway env vars, not in committed files.
HF_TOKEN=

# --- Database (prediction logging) ---
# With Kafka off, the API writes predictions straight to the DB (the /logs endpoint
# reads them back). Set DB_LOGGING_ENABLED=false for a fully stateless deploy with no DB.
DB_LOGGING_ENABLED=true
DB_BACKEND=postgres

# Local bundled Postgres credentials used by docker-compose.runtime.yml.
POSTGRES_USER=lung
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lung_detection

# Full SQLAlchemy URL. Leave empty to use the bundled db-runtime service above.
# In the cloud, set it to your managed Postgres (Render/Railway inject DATABASE_URL).
DATABASE_URL=postgresql+psycopg2://demo_user:demo_password@demo-postgres-host:5432/lung_detection
# Managed Postgres usually needs TLS; uncomment when using one (ignored if DATABASE_URL has it).
DB_SSLMODE=require

# Logs endpoint API key (leave empty to disable the /logs endpoint).
LOGS_API_KEY=demo_logs_api_key_change_me

# --- Prediction artifact storage ---
# local: save files under /app/assets/predictions
# supabase: upload files to Supabase Storage and store returned links
PREDICTION_STORAGE_BACKEND=supabase
PREDICTION_PUBLIC_BASE_URL=/static/predictions

# Supabase Storage (used when PREDICTION_STORAGE_BACKEND=supabase).
# Keep SUPABASE_SERVICE_ROLE_KEY only in local/server env files, never in frontend code.
SUPABASE_URL=https://demo-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=demo_supabase_secret_key_change_me
SUPABASE_STORAGE_BUCKET=lung-detection-predictions
SUPABASE_SIGNED_URL_EXPIRES_SECONDS=3600
