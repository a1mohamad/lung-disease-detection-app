# Runtime (local)
TF_CPP_MIN_LOG_LEVEL=3
TF_ENABLE_ONEDNN_OPTS=0

# Database (local SQL Server)
DB_BACKEND=mssql
DB_HOST=localhost\SQLEXPRESS
DB_PORT=1433
DB_NAME=lung_detection
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
DB_ECHO=false
DB_LOGGING_ENABLED=true

# --- Alternative: PostgreSQL instead of SQL Server ---
# Set DB_BACKEND=postgres and point the DB_* vars at Postgres (DB_PORT defaults to 5432),
# or provide a full DATABASE_URL which overrides every DB_* value above:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/lung_detection
# Managed Postgres usually needs TLS:
# DB_SSLMODE=require

# Logs endpoint API key
LOGS_API_KEY=your_long_random_api_key

# Kafka (local)
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_ADVERTISED_HOST=127.0.0.1
KAFKA_EXTERNAL_PORT=9092
KAFKA_TOPIC_PREDICTIONS=lung.predictions
KAFKA_CLIENT_ID=lung-api-producer
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=demo_kafka_user
KAFKA_SASL_PASSWORD=demo_kafka_password
KAFKA_GROUP_DB=lung-consumer-db
KAFKA_GROUP_MONITORING=lung-consumer-monitoring
KAFKA_GROUP_ANALYTICS=lung-consumer-analytics
KAFKA_GROUP_DOCTOR=lung-consumer-doctor
KAFKA_GROUP_NOTIFICATIONS=lung-consumer-notifications

# MLflow (local app behavior)
MLFLOW_ENABLED=false
MLFLOW_STRICT=false
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_MODEL_STAGE=Production
MLFLOW_MODEL_NAME_DENSENET_BINARY=lung-binary-densenet
MLFLOW_MODEL_NAME_EFFICIENTNET_BINARY=lung-binary-efficientnet
MLFLOW_MODEL_NAME_INCEPTION_BINARY=lung-binary-inception
MLFLOW_MODEL_NAME_MOBILENET_BINARY=lung-binary-mobilenet
MLFLOW_MODEL_NAME_DISEASES=lung-diseases-densenet
MLFLOW_MODEL_NAME_SEGMENTATION=lung-segmentation-unet-xception

# Prediction artifact storage
PREDICTION_STORAGE_BACKEND=local
PREDICTION_PUBLIC_BASE_URL=/static/predictions
SUPABASE_URL=https://demo-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=demo_supabase_secret_key_change_me
SUPABASE_STORAGE_BUCKET=lung-detection-predictions
SUPABASE_SIGNED_URL_EXPIRES_SECONDS=3600
