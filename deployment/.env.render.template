# Render Web Service environment variables.
# Use this as a copy/paste template for Render's "Add from .env" box.
# Do not commit a real deployment/.env.render file with secrets.

MODEL_RUNTIME=onnx
TF_CPP_MIN_LOG_LEVEL=3
TF_ENABLE_ONEDNN_OPTS=0

KAFKA_ENABLED=false
MLFLOW_ENABLED=false
MLFLOW_STRICT=false

HF_MODEL_DOWNLOAD_ENABLED=true
HF_MODEL_REPO_ID=a1mohamadd/lung-disease-detection
HF_MODEL_REPO_TYPE=model
HF_MODEL_REVISION=main
HF_MODEL_REPO_SUBDIR=
# Leave empty if the Hugging Face model repo is public.
HF_TOKEN=

DB_LOGGING_ENABLED=true
DB_BACKEND=postgres
# Prefer Render's Internal Database URL.
# If you use an External Database URL and connection fails, add ?sslmode=require.
DATABASE_URL=PASTE_RENDER_POSTGRES_INTERNAL_DATABASE_URL_HERE

PREDICTION_STORAGE_BACKEND=supabase
SUPABASE_URL=PASTE_SUPABASE_PROJECT_URL_HERE
SUPABASE_SERVICE_ROLE_KEY=PASTE_SUPABASE_SERVICE_ROLE_KEY_HERE
SUPABASE_STORAGE_BUCKET=lung-detection-predictions
SUPABASE_SIGNED_URL_EXPIRES_SECONDS=3600

LOGS_API_KEY=MAKE_A_LONG_RANDOM_SECRET_HERE

# Leave empty until GitHub Pages frontend is deployed.
# Example later: CORS_ALLOW_ORIGINS=https://a1mohamad.github.io
CORS_ALLOW_ORIGINS=
